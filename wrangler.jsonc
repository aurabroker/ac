// Cloudflare Workers Static Assets — serwis bez kodu Workera (MVP).
// Route'y produkcji (www.auraconsulting.pl/*) NIE są w tym pliku — zarządza nimi właściciel w panelu
// (docs/cloudflare-checklist.md). Deploy: .github/workflows/deploy.yml (wrangler-action).
{
  "name": "aura-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // produkcja nie jest wystawiona na *.workers.dev
  "workers_dev": false,
  // adresy podglądu wersji (gałęzie ≠ main) — chronione Cloudflare Access (checklista)
  "preview_urls": true,
  "observability": { "enabled": true }
}
