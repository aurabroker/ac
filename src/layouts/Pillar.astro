---
/**
 * Filar (PLAN §5.5): tabliczka → „W skrócie” → hero (rysunek z ploterem) → treść (BOM-y, scenariusze,
 * SpecTable, USA i Kanada, „Czego nie obejmuje”) → tabela zakresu → FAQ → „Arkusze szczegółowe”
 * → formuły (d) i (c) → kontakt → autor → rejestr zmian → źródła → pełna tabliczka.
 */
import Sheet from './Sheet.astro';
import SheetHead from '../components/SheetHead.astro';
import SheetFoot from '../components/SheetFoot.astro';
import DocBody from '../components/DocBody.astro';
import AnnotatedFigure from '../components/AnnotatedFigure.astro';
import BOM from '../components/BOM.astro';
import FAQ from '../components/FAQ.astro';
import Sources from '../components/Sources.astro';
import Disclosure from '../components/Disclosure.astro';
import ContactChannels from '../components/ContactChannels.astro';
import HubArticles from '../components/lists/HubArticles.astro';
import RelatedSheets from '../components/lists/RelatedSheets.astro';
import type { PageContext } from '../lib/page.ts';
import type { PillarEntry } from '../lib/routes.ts';

interface Props {
  ctx: PageContext;
  headings: { depth: number; slug: string; text: string }[];
}
const { ctx, headings } = Astro.props;
const d = (ctx.route.entry as PillarEntry).data;
const tocExtra = [
  ...(d.coverage.length && d.coveragePlacement === 'auto' ? [{ slug: 'tabela-zakresu', text: 'Tabela zakresu' }] : []),
  ...(d.faq.length ? [{ slug: 'faq', text: 'Najczęściej zadawane pytania' }] : []),
  { slug: 'kontakt', text: 'Zleć analizę ryzyka' },
];
---

<Sheet ctx={ctx} kind="pillar">
  <div class="container">
    <SheetHead ctx={ctx} lead={d.lead} titleAccent={d.titleAccent} />
    {d.figure && <AnnotatedFigure figure={d.figure} caption={d.figureCaption} plotter />}
    <DocBody headings={headings} tocExtra={tocExtra}>
      <div class="prose"><slot /></div>
      {
        d.coverage.length > 0 && d.coveragePlacement === 'auto' && (
          <BOM id="tabela-zakresu" caption={d.coverageCaption ?? 'Tabela zakresu'} rows={d.coverage} />
        )
      }
      <FAQ items={d.faq} />
      <HubArticles hubPath={ctx.path} />
      <Disclosure show={['d', 'c']} />
      <ContactChannels sheet={d.sheet} />
      <RelatedSheets paths={d.related} />
      <Sources items={d.sources} />
      <SheetFoot ctx={ctx} />
    </DocBody>
  </div>
</Sheet>
