---
/**
 * Indeks katalogu: filary + karty (solutions) pogrupowane wg pola `group`, w kolejności `order`.
 * Filtry (z JS, src/scripts/catalogue-filter.ts): ryzyko (grupa) i branża — natychmiastowe, przyciski
 * aria-pressed, stan w adresie (#ryzyko=…&branza=…). Bez JS widać pełny katalog; filtry mają `hidden`.
 */
import SheetCard from '../SheetCard.astro';
import { CATALOGUE_INDUSTRIES, groupShort, industriesFor } from '../../lib/catalogue-filters.ts';
import CardGrid from '../CardGrid.astro';
import { getRoutes, type PillarEntry, type SolutionEntry } from '../../lib/routes.ts';
import { polishText } from '../../lib/typography/polish.ts';

const routes = await getRoutes();
const byOrder = (a: (typeof routes)[number], b: (typeof routes)[number]) =>
  (a.entry as PillarEntry).data.order - (b.entry as PillarEntry).data.order;
// „Główne obszary” = cztery filary; segmenty i pod-huby (id z „/”) jako linia pod siatką
const pillars = routes.filter((r) => r.kind === 'pillar' && !r.entry.id.includes('/')).sort(byOrder);
const segments = routes.filter((r) => r.kind === 'pillar' && r.entry.id.includes('/')).sort(byOrder);
const cards = routes
  .filter((r) => r.kind === 'solution')
  .sort((a, b) => (a.entry as SolutionEntry).data.order - (b.entry as SolutionEntry).data.order);
const groups: { name: string; items: typeof cards }[] = [];
for (const c of cards) {
  const g = (c.entry as SolutionEntry).data.group;
  let grp = groups.find((x) => x.name === g);
  if (!grp) groups.push((grp = { name: g, items: [] }));
  grp.items.push(c);
}
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ł/g, 'l').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const markets = (m: string[]) => m.map((x) => (x === 'krajowy' ? 'rynek krajowy' : 'rynek zagraniczny')).join(' · ');
const risks = [{ id: 'filary', label: 'Główne obszary' }, ...groups.map((g) => ({ id: slug(g.name), label: groupShort(g.name) }))];
const ind = (path: string) => industriesFor(path).join(' ');
const total = pillars.length + cards.length;
const sheets = (n: number) => {
  const d = n % 10;
  const t = n % 100;
  return n === 1 ? 'arkusz' : d >= 2 && d <= 4 && (t < 12 || t > 14) ? 'arkusze' : 'arkuszy';
};
---

<h2 id="karty-katalogu" class="cat-head">Karty katalogu</h2>
<p class="cat-lead">
  {polishText(`${total} ${sheets(total)}: główne obszary i karty pogrupowane według rodzaju ryzyka.`)}
</p>

<div class="cat-filter" data-cat-filter data-md-skip hidden>
  <div class="cat-filter__row" role="group" aria-label="Filtr: ryzyko">
    <span class="cat-filter__label">Ryzyko</span>
    <div class="cat-filter__chips">
      <button type="button" class="cat-chip" data-f="ryzyko" data-v="" aria-pressed="true">Wszystkie</button>
      {
        risks.map((r) => (
          <button type="button" class="cat-chip" data-f="ryzyko" data-v={r.id} aria-pressed="false">
            {polishText(r.label)}
          </button>
        ))
      }
    </div>
  </div>
  <div class="cat-filter__row" role="group" aria-label="Filtr: branża">
    <span class="cat-filter__label">Branża</span>
    <div class="cat-filter__chips">
      <button type="button" class="cat-chip" data-f="branza" data-v="" aria-pressed="true">Wszystkie</button>
      {
        CATALOGUE_INDUSTRIES.map((i) => (
          <button type="button" class="cat-chip" data-f="branza" data-v={i.id} aria-pressed="false">
            {polishText(i.label)}
          </button>
        ))
      }
    </div>
  </div>
  <div class="cat-filter__foot">
    <p class="cat-filter__count" role="status" aria-live="polite" data-cat-count>
      {total} {sheets(total)} w katalogu
    </p>
    <button type="button" class="cat-filter__reset" data-cat-reset hidden>Pokaż wszystko</button>
  </div>
</div>

<section class="catalogue" aria-labelledby="filary" data-cat-group="filary">
  <h3 id="filary">Główne obszary</h3>
  <CardGrid columns={2}>
    {
      pillars.map((r) => {
        const d = (r.entry as PillarEntry).data;
        return (
          <div class="cat-item" data-cat-item data-risk="filary" data-ind={ind(r.path)}>
            <SheetCard href={r.path} title={d.title} sheet={d.sheet} summary={d.cardSummary ?? d.description} meta={markets(d.markets)} draft={r.draft} />
          </div>
        );
      })
    }
  </CardGrid>
  {
    segments.length > 0 && (
      <p class="catalogue__sub">
        <span class="label">Arkusze uzupełniające</span>{' '}
        {segments.map((r, i) => (
          <>
            {i > 0 && ' · '}
            <a href={r.path}>{polishText(r.entry.data.title)}</a>
          </>
        ))}
      </p>
    )
  }

  {
    groups.map((g) => (
      <section class="catalogue__group" aria-labelledby={`grupa-${slug(g.name)}`} data-cat-group={slug(g.name)}>
        <h3 id={`grupa-${slug(g.name)}`}>{g.name}</h3>
        <CardGrid columns={3}>
          {g.items.map((r) => {
            const d = (r.entry as SolutionEntry).data;
            return (
              <div class="cat-item" data-cat-item data-risk={slug(g.name)} data-ind={ind(r.path)}>
                <SheetCard
                  href={r.path}
                  title={d.title}
                  sheet={d.code}
                  summary={d.cardSummary ?? d.description}
                  meta={markets(d.markets)}
                  draft={r.draft}
                />
              </div>
            );
          })}
        </CardGrid>
      </section>
    ))
  }
</section>

<script>
  import '../../scripts/catalogue-filter.ts';
</script>

<style>
  .catalogue {
    margin-top: var(--s-4);
  }
  .catalogue[hidden],
  .catalogue__group[hidden],
  .cat-item[hidden] {
    display: none;
  }
  .cat-item {
    min-width: 0;
  }
  .cat-filter {
    margin-top: var(--s-3);
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--ink);
  }
  .cat-filter[hidden] {
    display: none;
  }
  .cat-filter__row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--s-1) var(--s-2);
    align-items: start;
    padding-block: var(--s-1);
  }
  .cat-filter__row + .cat-filter__row {
    border-top: 1px solid var(--rule);
    padding-top: 12px;
  }
  .cat-filter__label {
    padding-top: 10px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .cat-filter__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cat-chip {
    -webkit-tap-highlight-color: transparent;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 6px 12px;
    border: 1px solid var(--rule);
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    line-height: 1.3;
    text-align: left;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      border-color 120ms var(--ease),
      background-color 120ms var(--ease),
      color 120ms var(--ease);
  }
  .cat-chip::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border: 1px solid var(--ink-4);
  }
  .cat-chip:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .cat-chip[aria-pressed='true'] {
    border-color: var(--blue);
    background: var(--blue-wash);
    color: var(--ink);
  }
  .cat-chip[aria-pressed='true']::before {
    border-color: var(--blue);
    background: var(--blue);
  }
  .cat-filter__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-2);
    margin-top: var(--s-1);
    padding-top: var(--s-1);
    border-top: 1px solid var(--rule);
  }
  .cat-filter__count {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--ink-3);
  }
  .cat-filter__reset {
    min-height: 32px;
    padding: 4px 0;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--blue);
    cursor: pointer;
  }
  .cat-filter__reset:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cat-filter__reset[hidden] {
    display: none;
  }
  /* wąski ekran: każdy filtr w jednym przewijanym wierszu (przewija się tylko wiersz, nie strona);
     wygaszenie przy prawej krawędzi pokazuje, że wiersz ma ciąg dalszy */
  @media (max-width: 640px) {
    .cat-filter {
      padding-inline: var(--s-2);
    }
    .cat-filter__row {
      grid-template-columns: minmax(0, 1fr);
    }
    .cat-filter__label {
      padding-top: 0;
    }
    .cat-filter__chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      padding-bottom: 6px;
      padding-inline-end: 32px;
      mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
      scrollbar-width: thin;
    }
    .cat-chip {
      flex: none;
      white-space: nowrap;
      scroll-snap-align: start;
    }
  }
  .cat-head {
    margin-top: var(--s-8);
    padding-top: var(--s-3);
    border-top: 1px solid var(--ink);
  }
  .cat-lead {
    max-width: var(--measure);
    color: var(--ink-2);
  }
  .catalogue h3 {
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
  }
  .catalogue__group {
    margin-top: var(--s-8);
  }
  .catalogue__sub {
    margin-top: calc(-1 * var(--s-1));
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .catalogue__sub .label {
    display: inline;
    margin-right: var(--s-1);
  }
</style>
