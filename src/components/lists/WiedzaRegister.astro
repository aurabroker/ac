---
/**
 * Blog (/wiedza/): lista artykułów jako karty — miniatura (rysunek izometryczny), kategoria, tytuł, zajawka, data, czas czytania.
 * Gdy brak opublikowanych artykułów: krótki komunikat i linki do głównych tematów.
 */
import { getRoutes, type PillarEntry } from '../../lib/routes.ts';
import { fmtDate, isoDate } from '../../lib/format.ts';
import { polishText } from '../../lib/typography/polish.ts';
import { figPathFor } from '../../lib/iso/spec.ts';

const routes = await getRoutes();
const posts = routes
  .filter((r) => r.kind === 'article' || r.kind === 'regulation')
  .sort((a, b) => (b.entry.data.published ?? b.entry.data.updated).getTime() - (a.entry.data.published ?? a.entry.data.updated).getTime());
const titleOf = (path: string | undefined) => (path ? routes.find((r) => r.path === path)?.entry.data.title : undefined);
const CATEGORY: Record<string, string> = {
  '/oc-cyber-dla-it/': 'OC i cyber dla IT',
  '/ubezpieczenie-ai/': 'Ubezpieczenie AI',
  '/ubezpieczenie-cyber/': 'Cyber',
  '/oc-zawodowe/': 'OC zawodowe',
};
const categoryOf = (r: (typeof posts)[number]) => {
  const hub = (r.entry.data as { hub?: string }).hub;
  if (r.kind === 'regulation') return 'Regulacje';
  return (hub && (CATEGORY[hub] ?? titleOf(hub))) || 'Wiedza';
};
const minutes = (body: string | undefined) => Math.max(3, Math.round((body ?? '').split(/\s+/).filter(Boolean).length / 200));
const pillars = routes
  .filter((r) => r.kind === 'pillar' && !r.entry.id.includes('/'))
  .sort((a, b) => (a.entry as PillarEntry).data.order - (b.entry as PillarEntry).data.order);
---

{
  posts.length > 0 ? (
    <ul class="blog" role="list">
      {posts.map((r) => (
        <li class="blog__item">
          <article class="post">
            <div class="post__fig" aria-hidden="true" data-md-skip>
              <img src={figPathFor(r.path)} width="360" height="190" loading="lazy" decoding="async" alt="" />
            </div>
            <p class="post__meta mono">
              <span class="post__cat">{categoryOf(r)}</span>
              {r.scheduled ? (
                <span class="post__plan">
                  Zaplanowano: <time datetime={isoDate(r.entry.data.published)}>{fmtDate(r.entry.data.published)}</time>
                </span>
              ) : (
                <span>
                  <time datetime={isoDate(r.entry.data.published)}>{fmtDate(r.entry.data.published)}</time>
                </span>
              )}
              <span>{minutes(r.entry.body)} min czytania</span>
              {r.draft && <span class="post__draft">SZKIC</span>}
            </p>
            <h2 class="post__title">
              <a href={r.path}>{polishText(r.entry.data.title)}</a>
            </h2>
            <p class="post__lead">{polishText(r.entry.data.description)}</p>
            <p class="post__more" data-md-skip>
              <a href={r.path} aria-hidden="true" tabindex="-1">Czytaj artykuł →</a>
            </p>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <section class="blog-empty" aria-labelledby="wkrotce">
      <h2 id="wkrotce">Pierwsze artykuły już wkrótce</h2>
      <p>Do tego czasu najważniejsze odpowiedzi znajdziesz na stronach głównych tematów:</p>
      <ul>
        {pillars.map((r) => (
          <li>
            <a href={r.path}>{polishText(r.entry.data.title)}</a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .blog {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--s-4);
  }
  .post {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-4);
    border: 1px solid var(--rule);
    background: #fff;
    transition: border-color 0.2s ease;
  }
  .post:hover,
  .post:focus-within {
    border-color: var(--ink);
  }
  /* miniatura artykułu (rysunek izometryczny, /fig/…svg) na całą szerokość karty */
  .post__fig {
    margin: calc(-1 * var(--s-4)) calc(-1 * var(--s-4)) var(--s-1);
    border-bottom: 1px solid var(--rule);
    transition: border-color 0.2s ease;
  }
  .post__fig img {
    display: block;
    width: 100%;
    height: auto;
  }
  .post:hover .post__fig,
  .post:focus-within .post__fig {
    border-color: var(--ink);
  }
  /* pozycje nie łamią się w środku; kropka przed każdą pozycją, a ta na początku wiersza jest przycięta */
  .post__meta {
    --sep: 1.4em;
    display: flex;
    flex-wrap: wrap;
    margin: 0 0 0 calc(-1 * var(--sep));
    clip-path: inset(0 0 0 var(--sep));
    font-size: var(--fs-mono);
    color: var(--ink-3);
  }
  .post__meta > span {
    white-space: nowrap;
  }
  .post__meta > span::before {
    content: '·';
    content: '·' / '';
    display: inline-block;
    width: var(--sep);
    text-align: center;
    color: var(--ink-3);
  }
  .post__cat {
    color: var(--blue, var(--ink-2));
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
  .post__draft {
    color: var(--signal);
  }
  .post__plan {
    color: var(--ink);
  }
  .post__title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.25;
  }
  .post__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post {
    position: relative;
  }
  .post__title a:hover,
  .post__title a:focus-visible {
    text-decoration: underline;
  }
  .post__lead {
    margin: 0;
    color: var(--ink-2);
    flex: 1;
  }
  .post__more {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }
  .blog-empty {
    max-width: var(--measure);
    margin-top: var(--s-8);
  }
  .blog-empty p,
  .blog-empty ul {
    margin-top: var(--s-2);
  }
  .blog-empty ul {
    padding-left: 1.2em;
  }
</style>
