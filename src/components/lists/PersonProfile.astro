---
/**
 * Profil osoby: spółka, w której pracuje, z danymi z rejestru KNF (i LinkedIn, gdy podany).
 * Bez powtórzenia imienia z H1 i bez rejestru „opracowanych arkuszy” — strona opisuje osobę, nie autorstwo.
 */
import { SITE } from '../../lib/site.ts';
import { isKnownPerson, type Person } from '../../lib/people.ts';

interface Props {
  person: Person;
}
const { person } = Astro.props;
---

<section class="person" aria-labelledby="profil">
  <h2 id="profil">Spółka</h2>
  <dl class="person__facts">
    <div>
      <dt>Firma</dt>
      <dd>{SITE.legalName}, <a href="/o-nas/">broker ubezpieczeniowy</a></dd>
    </div>
    <div>
      <dt>Zezwolenie KNF</dt>
      <dd>nr {SITE.knfPermit}</dd>
    </div>
    <div>
      <dt>Rejestr brokerów</dt>
      <dd>{SITE.brokerRegister}</dd>
    </div>
    {
      isKnownPerson(person) && person.linkedin && (
        <div>
          <dt>LinkedIn</dt>
          <dd>
            <a href={person.linkedin} rel="me noopener">
              {person.linkedin.replace(/^https?:\/\//, '')}
            </a>
          </dd>
        </div>
      )
    }
  </dl>
</section>

<style>
  .person {
    max-width: var(--measure);
    margin-top: var(--s-8);
  }
  .person h2 {
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
    margin-top: var(--s-6);
  }
  .person__facts {
    margin: var(--s-2) 0 0;
  }
  .person__facts div {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--gutter);
    padding-block: var(--s-1);
    border-bottom: 1px solid var(--rule);
  }
  .person__facts dt {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
    padding-top: 4px;
  }
  .person__facts dd {
    margin: 0;
  }
  @media (max-width: 640px) {
    .person__facts div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
