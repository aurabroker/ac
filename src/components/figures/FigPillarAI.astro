---
/**
 * FigPillarAI — F-AI: schemat systemu AI. Dane wejściowe → obudowa modelu w przekroju (sieć neuronowa,
 * gniazdo klucza API) → zawór weryfikacji → karta kontrolna wyników z pasmem tolerancji.
 * Jeden punkt poza tolerancją oznaczony chmurką rewizyjną (redline): halucynacja.
 * Właściciel: agent „figures”. Treść merytoryczna: legenda HTML w FIGURE_META (./index.ts).
 */
import FigFrame from './FigFrame.astro';
import { circle, cloud, dimV, f, hatch, head, p, poly, seg, type Pt } from './draw.ts';

interface Props {
  labelledby?: string;
  title?: string;
}
const { labelledby, title = 'Schemat: system AI od danych wejściowych do wyniku' } = Astro.props;
const desc =
  'Po lewej stos arkuszy danych wejściowych, strzałka do obudowy narysowanej w przekroju z kreskowanymi ściankami. ' +
  'W obudowie sieć neuronowa: cztery warstwy węzłów połączonych liniami, na górnej ściance gniazdo klucza. ' +
  'Wyjście przechodzi przez symbol zaworu do karty kontrolnej: punkty wyników mieszczą się w niebieskim paśmie tolerancji, ' +
  'jeden punkt jest poza pasmem i otacza go czerwona chmurka z podpisem halucynacja.';

// obudowa modelu (przekrój ścianek)
const X0 = 200;
const X1 = 500;
const Y0 = 70;
const Y1 = 290;
const T = 10;
const yc = 180;
const outer = poly([[X0, Y0], [X1, Y0], [X1, Y1], [X0, Y1]], true);
const inner = poly([[X0 + T, Y0 + T], [X1 - T, Y0 + T], [X1 - T, Y1 - T], [X0 + T, Y1 - T]], true);
const walls =
  hatch([[X0, Y0], [X1, Y0], [X1, Y0 + T], [X0, Y0 + T]], 4.5, 45) +
  hatch([[X0, Y1 - T], [X1, Y1 - T], [X1, Y1], [X0, Y1]], 4.5, 45) +
  hatch([[X0, Y0 + T], [X0 + T, Y0 + T], [X0 + T, Y1 - T], [X0, Y1 - T]], 4.5, 45) +
  hatch([[X1 - T, Y0 + T], [X1, Y0 + T], [X1, Y1 - T], [X1 - T, Y1 - T]], 4.5, 45);
const port = (x: number) => poly([[x - 6, yc - 13], [x + 6, yc - 13], [x + 6, yc + 13], [x - 6, yc + 13]], true);
const keyX = 414;
const keyPort = poly([[keyX - 14, Y0 - 9], [keyX + 14, Y0 - 9], [keyX + 14, Y0 + T], [keyX - 14, Y0 + T]], true);
const keySlot = seg([keyX - 7, Y0 - 1], [keyX + 7, Y0 - 1]);

// sieć: warstwy węzłów
const layers = [
  { x: 252, n: 4 },
  { x: 318, n: 6 },
  { x: 386, n: 6 },
  { x: 450, n: 3 },
];
const GAP = 30;
const nodes = layers.map((l) => Array.from({ length: l.n }, (_, i): Pt => [l.x, yc + (i - (l.n - 1) / 2) * GAP]));
const NR = 6.5;
let links = '';
for (let i = 0; i + 1 < nodes.length; i++)
  for (const a of nodes[i]) for (const b of nodes[i + 1]) links += seg([a[0] + NR, a[1]], [b[0] - NR, b[1]]);
const nodePath = nodes.flat().map(([x, y]) => circle(x, y, NR)).join('');
const inLinks = nodes[0].map(([x, y]) => seg([X0 + 6, yc], [x - NR, y])).join('');
const outLinks = nodes[3].map(([x, y]) => seg([x + NR, y], [X1 - 6, yc])).join('');

// dane wejściowe: stos arkuszy
const sheet = (dx: number): Pt[] => [[40 + dx, 150 - dx], [110 + dx, 150 - dx], [110 + dx, 206 - dx], [40 + dx, 206 - dx]];
const sheets = [12, 6, 0].map((d) => poly(sheet(d), true));
const rows = [162, 172, 182, 192].map((y, i) => seg([48, y], [i % 2 ? 88 : 100, y])).join('');

// wyjście: zawór weryfikacji i karta kontrolna
const vx = 548;
const valve =
  poly([[vx - 11, yc - 8], [vx, yc], [vx - 11, yc + 8]], true) +
  poly([[vx + 11, yc - 8], [vx, yc], [vx + 11, yc + 8]], true) +
  seg([vx, yc], [vx, yc - 17]) +
  seg([vx - 7, yc - 17], [vx + 7, yc - 17]);
const cx0 = 610;
const cx1 = 770;
const UCL = 146;
const LCL = 214;
const outLine = seg([X1 + 6, yc], [vx - 11, yc]) + seg([vx + 11, yc], [cx0 - 8, yc]);
const axes = `M${p(cx0, 92)}V${f(272)}H${f(cx1 + 4)}`;
const ticks = [110, 145, 180, 215, 250].map((y) => seg([cx0 - 4, y], [cx0, y])).join('');
const band = `M${p(cx0, UCL)}H${f(cx1)}M${p(cx0, LCL)}H${f(cx1)}`;
const vals = [178, 192, 168, 186, 198, 170, 106, 184];
const pts: Pt[] = vals.map((y, i) => [626 + i * 20, y]);
const series = poly(pts);
const dots = pts.map(([x, y]) => circle(x, y, 2.6)).join('');
const outlier = pts[6];
const tol = dimV(784, UCL, LCL, 6);
const tolExt = seg([cx1 + 2, UCL], [790, UCL]) + seg([cx1 + 2, LCL], [790, LCL]);
const redline = cloud(outlier[0], outlier[1], 15) + seg([outlier[0] - 11, outlier[1] - 12], [722, 62]);

// odnośniki
const R = 11;
const yRow = 326;
type Bal = { n: number; x: number; y: number; from: Pt; main: string; sub: string; red?: boolean };
const bals: Bal[] = [
  { n: 1, x: 60, y: yRow, from: [70, 206], main: 'DANE WEJŚCIOWE', sub: 'PRAWA · DANE OSOBOWE' },
  { n: 2, x: 232, y: yRow, from: [262, Y1], main: 'MODEL', sub: 'WŁASNY LUB DOSTAWCY' },
  { n: 4, x: 520, y: yRow, from: [vx, yc + 9], main: 'WERYFIKACJA', sub: 'NADZÓR CZŁOWIEKA' },
  { n: 5, x: 664, y: yRow, from: [744, 272], main: 'WYNIK', sub: 'DLA KLIENTA' },
  { n: 3, x: keyX, y: 30, from: [keyX, Y0 - 9], main: 'KLUCZ API', sub: 'NADUŻYCIE · LLMJACKING' },
  { n: 6, x: 604, y: 40, from: [604, 40], main: 'HALUCYNACJA', sub: 'WYNIK POZA TOLERANCJĄ', red: true },
];
const leader = (b: Bal) => {
  const dx = b.x - b.from[0];
  const dy = b.y - b.from[1];
  const L = Math.hypot(dx, dy);
  return L < R + 1 ? '' : seg(b.from, [b.x - (dx / L) * R, b.y - (dy / L) * R]);
};
---

<FigFrame viewBox="0 0 800 352" labelledby={labelledby} title={title} desc={desc}>
  <!-- konstrukcja: połączenia sieci, oś przepływu -->
  <path class="c" d={links} pathLength="1" data-part="2" />
  <line class="ax" x1="24" y1={yc} x2={cx0 - 12} y2={yc} />

  <!-- 1 dane wejściowe -->
  {sheets.map((d) => <path class="f" d={d} data-part="1" />)}
  <path class="o2" d={sheets.join('')} pathLength="1" data-part="1" />
  <path class="c" d={rows} pathLength="1" data-part="1" />
  <path class="o" d={seg([112, yc], [X0 - 8, yc])} pathLength="1" data-part="1" />
  <path class="ah fx" d={head(X0 - 6, yc, 0, 9, 2.6)} data-part="1" />

  <!-- 2 obudowa modelu w przekroju, 3 gniazdo klucza API -->
  <path class="x fx" d={walls} data-part="2" />
  <path class="o" d={outer + inner} pathLength="1" data-part="2" />
  <path class="f" d={port(X0) + port(X1)} data-part="2" />
  <path class="o" d={port(X0) + port(X1)} pathLength="1" data-part="2" />
  <path class="f" d={keyPort} data-part="3" />
  <path class="o" d={keyPort} pathLength="1" data-part="3" />
  <path class="o2" d={keySlot} pathLength="1" data-part="3" />
  <path class="o2" d={inLinks + outLinks} pathLength="1" data-part="2" />
  <path class="b" d={nodePath} pathLength="1" data-part="2" />
  <text class="t t-s" x={X0 + T + 8} y={Y1 - T - 10} data-part="2">MODEL · WARSTWY</text>

  <!-- 4 weryfikacja, 5 karta kontrolna wyników -->
  <path class="o" d={outLine} pathLength="1" />
  <path class="ah fx" d={head(cx0 - 6, yc, 0, 9, 2.6)} />
  <path class="f" d={valve} data-part="4" />
  <path class="o" d={valve} pathLength="1" data-part="4" />
  <path class="o2" d={axes + ticks} pathLength="1" data-part="5" />
  <line class="ax" x1={cx0} y1={yc} x2={cx1} y2={yc} />
  <path class="d" d={band + tol.line} pathLength="1" data-part="5" />
  <path class="c" d={tolExt} pathLength="1" data-part="5" />
  <path class="d-fill fx" d={tol.heads} data-part="5" />
  <path class="o2" d={series} pathLength="1" data-part="5" />
  <path class="dot fx" d={dots} data-part="5" />
  <text class="t-dim" transform={`translate(${f(797)} ${yc}) rotate(-90)`} data-part="5">TOLERANCJA</text>
  <text class="t t-s" x={cx0 + 6} y="290" data-part="5">KARTA KONTROLNA</text>

  <!-- 6 halucynacja: jedyny redline -->
  <path class="sig" d={redline} pathLength="1" data-part="6" />

  <!-- odnośniki -->
  {bals.map((b) => leader(b) && <path class="l" d={leader(b)} pathLength="1" data-part={b.n} />)}
  {
    bals.map((b) => (
      <>
        <g class="bal" data-part={b.n}>
          <circle class="b" cx={b.x} cy={b.y} r={R} pathLength="1" />
          <text class="t-num" x={b.x} y={b.y}>
            {b.n}
          </text>
        </g>
        <text class:list={['t', 't-b', b.red && 't-sig']} x={b.x + 18} y={b.y - 1} data-part={b.n}>
          {b.main}
        </text>
        <text class="t t-s" x={b.x + 18} y={b.y + 11} data-part={b.n}>
          {b.sub}
        </text>
      </>
    ))
  }
</FigFrame>
