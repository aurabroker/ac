---
/**
 * Konfigurator programu ubezpieczenia (orientacyjny). 6 pytań jako przełączniki → zestawienie elementów
 * w stylu BOM: rdzeń / zalecane / do rozważenia, uwagi do zakresu, mailto do brokera i „Kopiuj podsumowanie”.
 *
 *   <ProgramConfigurator />                    pełny (strona główna, po czterech ścieżkach)
 *   <ProgramConfigurator compact />            zwarty (filary, blisko początku)
 *   <ProgramConfigurator compact preset="ai=tak" />   odpowiedź wstępnie zaznaczona
 *
 * Progresywne ulepszenie: bez JS (i w bliźniaku .md) widać tabelę zasad doboru; interfejs ma `hidden`
 * i odsłania go skrypt. Odpowiedzi nie opuszczają przeglądarki (tylko sessionStorage). Dane i reguły:
 * src/lib/configurator.ts. Skrypt: src/scripts/configurator.ts (~3 KB gz, tylko na stronach z konfiguratorem).
 */
import Icon from './Icon.astro';
import { MODULES, NOTES, QUESTIONS, RULES_TABLE, STATUS_LABEL, type Status } from '../lib/configurator.ts';
import { SITE } from '../lib/site.ts';
import { polishText } from '../lib/typography/polish.ts';

interface Props {
  compact?: boolean;
  /** Numer arkusza do tematu wiadomości. */
  sheet?: string;
  /** Wstępne odpowiedzi, np. "ai=tak" lub "branza=ai&ai=tak". */
  preset?: string;
  uid?: string;
}
const { compact = false, sheet = 'AC-000', preset, uid = 'cfg' } = Astro.props;
const mod = (id: string) => MODULES.find((m) => m.id === id)!;
const generic = (id: string) => {
  const m = mod(id);
  return m.variants.it ?? m.variants.gen;
};
const staticNotes = NOTES.filter((n) => ['usa', 'ai', 'umowy-it'].includes(n.id));
/** Tematy uwag (bez powtórzeń), małą literą tam, gdzie to zwykłe słowo („klauzula AI”, ale „USA i Kanada”). */
const noteTopics = [...new Set(NOTES.map((n) => n.title))].map((t) => (/^\p{Lu}\p{Ll}/u.test(t) ? t[0].toLowerCase() + t.slice(1) : t));
/** Objaśnienie statusów (bez JS i w .md). */
const STATUS_LEGEND: [Status, string][] = [
  ['core', 'podstawa programu przy Twojej działalności.'],
  ['rec', 'element, który warto mieć przy Twoim profilu ryzyka.'],
  ['opt', 'element zależny od sytuacji firmy, np. umów, przelewów albo struktury spółki.'],
];
const subject = `[${sheet}] Konfiguracja programu — prośba o analizę`;
const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}`;
---

<section
  class:list={['cfg', compact && 'cfg--compact']}
  data-cfg
  data-sheet={sheet}
  data-preset={preset}
  aria-label="Konfigurator programu ubezpieczenia"
>
  <div class="cfg__head" data-md-skip>
    <span class="cfg__code"><Icon name="layers" size={16} />Konfigurator programu · {sheet}</span>
    <span class="cfg__tag">Orientacyjnie · to nie jest oferta</span>
  </div>

  <div class="cfg__static" data-cfg-static>
    <p class="label cfg__static-title">Pytania konfiguratora</p>
    <ol class="cfg__static-qs">
      {
        QUESTIONS.map((q) => (
          <li>
            <strong>{polishText(q.legend)}</strong> {polishText(q.options.map((o) => o.label).join(' · '))}
          </li>
        ))
      }
    </ol>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Zasady doboru programu">
      <table>
        <caption>Zasady doboru programu (orientacyjnie)</caption>
        <thead>
          <tr>
            <th scope="col">Element programu</th>
            <th scope="col">Kiedy go rozważyć</th>
            <th scope="col">Dlaczego</th>
          </tr>
        </thead>
        <tbody>
          {
            RULES_TABLE.map((r) => {
              const v = generic(r.module);
              return (
                <tr>
                  <th scope="row">
                    <a href={v.href}>{polishText(v.name)}</a>
                  </th>
                  <td>{polishText(r.when)}</td>
                  <td>{polishText(v.text)}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p class="label cfg__static-title">Status elementu w zestawieniu</p>
    <ul class="cfg__static-notes">
      {
        STATUS_LEGEND.map(([k, text]) => (
          <li>
            <strong>{STATUS_LABEL[k]}</strong> — {polishText(text)}
          </li>
        ))
      }
    </ul>
    <p class="label cfg__static-title">Do sprawdzenia w polisie — przykłady</p>
    <p class="cfg__static-sub">
      {polishText(`Konfigurator dobiera uwagi do odpowiedzi. Tematy: ${noteTopics.join('; ')}. Trzy najczęstsze:`)}
    </p>
    <ul class="cfg__static-notes">
      {
        staticNotes.map((n) => (
          <li>
            <strong>{polishText(n.title)}.</strong> {polishText(n.text)} <a href={n.href}>{polishText(n.link)}</a>.
          </li>
        ))
      }
    </ul>
    <p class="cfg__disclaimer">
      {polishText('Zestawienie orientacyjne — nie jest ofertą ani poradą. Zakres, limity i wyłączenia potwierdzamy w ofercie i polisie.')}
    </p>
  </div>

  <div class="cfg__ui" data-cfg-ui hidden>
    <form class="cfg__form" data-cfg-form aria-label="Pytania konfiguratora">
      {
        QUESTIONS.map((q, i) => (
          <fieldset class="cfg__q" data-q={q.id} data-q-label={q.short}>
            <legend class="cfg__legend">
              <span class="cfg__qn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {polishText(q.legend)}
            </legend>
            <div class="cfg__chips">
              {q.options.map((o) => (
                <label class="cfg__chip">
                  <input type="radio" name={`${uid}-${q.id}`} value={o.value} />
                  <span>{polishText(o.label)}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }
      <div class="cfg__formfoot">
        <span class="cfg__count" data-cfg-count>0 z {QUESTIONS.length} odpowiedzi</span>
        <button type="reset" class="cfg__reset">Wyczyść</button>
      </div>
    </form>

    <div class="cfg__sheet">
      <div class="cfg__sheet-head">
        <p class="cfg__sheet-title">Zestawienie elementów programu</p>
        <p class="cfg__sheet-meta" data-cfg-meta></p>
      </div>
      <ol class="cfg__bom" data-cfg-bom>
        {
          MODULES.map((m) => (
            <li class="cfg__row" data-mod={m.id} hidden>
              <span class="cfg__pos" data-pos>
                00
              </span>
              <span class="cfg__icon" aria-hidden="true">
                <Icon name={m.icon} size={22} />
              </span>
              <div class="cfg__body">
                {Object.entries(m.variants).map(([k, v]) => (
                  <div class="cfg__var" data-var={k} hidden>
                    <p class="cfg__name" data-name>
                      {polishText(v.name)}
                    </p>
                    <p class="cfg__why">
                      <span class="cfg__why-text">{polishText(v.text)}</span>{' '}
                      <a class="cfg__more" href={v.href}>
                        {polishText(v.link)}
                        <Icon name="arrow-right" size={14} />
                      </a>
                    </p>
                  </div>
                ))}
              </div>
              <span class="cfg__status" data-status />
            </li>
          ))
        }
      </ol>

      <div class="cfg__notes-wrap" data-cfg-notes hidden>
        <p class="cfg__notes-title">Do sprawdzenia w polisie</p>
        <ul class="cfg__notes">
          {
            NOTES.map((n) => (
              <li class="cfg__note" data-note={n.id} data-title={n.title} hidden>
                <span class="cfg__note-icon" aria-hidden="true">
                  <Icon name={n.icon} size={18} />
                </span>
                <p>
                  <strong>{polishText(n.title)}.</strong> {polishText(n.text)}{' '}
                  <a class="cfg__more" href={n.href}>
                    {polishText(n.link)}
                    <Icon name="arrow-right" size={14} />
                  </a>
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="cfg__actions">
        <a class="btn btn--signal" href={mailto} data-cfg-mail>
          <Icon name="envelope" size={18} />Wyślij konfigurację do brokera
        </a>
        <button type="button" class="btn btn--quiet" data-cfg-copy hidden>
          <Icon name="copy" size={18} /><span data-label>Kopiuj podsumowanie</span>
        </button>
      </div>
      <p class="cfg__live visually-hidden" role="status" aria-live="polite" data-cfg-live></p>
      <p class="cfg__disclaimer">
        {
          polishText(
            'Wynik orientacyjny — nie jest ofertą ani poradą. Zakres, limity i wyłączenia potwierdzamy w ofercie i polisie. Odpowiedzi zostają w Twojej przeglądarce: wiadomość wysyłasz sam, ze swojej poczty.',
          )
        }
      </p>
    </div>
  </div>
</section>

<script>
  import '../scripts/configurator.ts';
</script>

<style>
  .cfg {
    margin-block: var(--s-6);
    border: 1px solid var(--ink);
    background: var(--paper);
  }
  .cfg__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-3);
    padding: var(--s-1) var(--s-3);
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .cfg__code {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--ink);
  }
  .cfg__tag {
    color: var(--ink-3);
  }
  .cfg__static {
    padding: var(--s-1) var(--s-3) var(--s-3);
  }
  .cfg__static .table-wrap {
    margin-block: var(--s-2);
  }
  .cfg__static-title {
    margin-top: var(--s-3);
  }
  .cfg__static-title:first-child {
    margin-top: var(--s-1);
  }
  .cfg__static-qs {
    margin: var(--s-1) 0 0;
    padding-left: 1.5em;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .cfg__static-qs li + li {
    margin-top: 0.4em;
  }
  .cfg__static-qs strong {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }
  .cfg__static-sub {
    margin-top: var(--s-1);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .cfg__static-notes {
    margin: var(--s-1) 0 0;
    padding-left: 1.25em;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .cfg__static-notes li + li {
    margin-top: 0.4em;
  }

  /* ---------- interfejs ---------- */
  .cfg__ui {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }
  .cfg__ui[hidden] {
    display: none;
  }
  .cfg__form {
    padding: var(--s-3);
  }
  .cfg__q {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .cfg__q + .cfg__q {
    margin-top: var(--s-3);
  }
  .cfg__legend {
    display: flex;
    gap: var(--s-1);
    padding: 0;
    margin-bottom: var(--s-1);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }
  .cfg__qn {
    flex: none;
    padding-top: 2px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 400;
    color: var(--blue);
  }
  .cfg__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cfg__chip {
    position: relative;
    display: inline-flex;
    -webkit-tap-highlight-color: transparent;
  }
  .cfg__chip input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .cfg__chip span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 6px 12px;
    border: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    line-height: 1.3;
    color: var(--ink-2);
    background: var(--paper);
    transition:
      border-color 120ms var(--ease),
      background-color 120ms var(--ease),
      color 120ms var(--ease);
  }
  /* znacznik: pusty kwadrat → wypełniony niebieski (jak pole w tabliczce) */
  .cfg__chip span::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border: 1px solid var(--ink-4);
    background: var(--paper);
  }
  .cfg__chip:hover span {
    border-color: var(--ink);
    color: var(--ink);
  }
  .cfg__chip input:checked + span {
    border-color: var(--blue);
    background: var(--blue-wash);
    color: var(--ink);
  }
  .cfg__chip input:checked + span::before {
    border-color: var(--blue);
    background: var(--blue);
  }
  .cfg__chip input:focus-visible + span {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }
  .cfg__formfoot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    margin-top: var(--s-3);
    padding-top: var(--s-2);
    border-top: 1px solid var(--rule);
  }
  .cfg__count {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--ink-3);
  }
  .cfg__reset {
    min-height: 32px;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-2);
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
  }
  .cfg__reset:hover {
    border-color: var(--rule);
    color: var(--ink);
  }

  /* ---------- zestawienie (BOM) ---------- */
  .cfg__sheet {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--s-3);
    border-left: 1px solid var(--rule);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--grid-minor) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-minor) 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .cfg__sheet-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-1) var(--s-2);
    padding-bottom: var(--s-1);
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .cfg__sheet-title {
    color: var(--ink);
  }
  .cfg__sheet-meta {
    color: var(--ink-3);
  }
  .cfg__bom {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--paper);
  }
  .cfg__row {
    display: grid;
    grid-template-columns: 2.25rem 40px minmax(0, 1fr) auto;
    gap: 0 var(--s-2);
    align-items: start;
    margin: 0;
    padding: var(--s-2) 0;
    border-bottom: 1px solid var(--rule);
  }
  .cfg__row[hidden],
  .cfg__var[hidden],
  .cfg__note[hidden] {
    display: none;
  }
  .cfg__pos {
    padding-top: 2px;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--ink-3);
  }
  .cfg__icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--rule);
    color: var(--ink-2);
  }
  .cfg__row[data-status='core'] .cfg__icon {
    border-color: var(--ink);
    color: var(--ink);
  }
  .cfg__row[data-status='rec'] .cfg__icon {
    border-color: var(--blue);
    color: var(--blue);
  }
  .cfg__name {
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }
  .cfg__why {
    margin-top: 2px;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .cfg__more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }
  .cfg__status {
    padding: 3px 7px 2px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.35;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1px solid var(--ink);
    color: var(--ink);
  }
  .cfg__row[data-status='rec'] .cfg__status {
    border-color: var(--blue);
    color: var(--blue);
  }
  .cfg__row[data-status='opt'] .cfg__status {
    border-style: dashed;
    border-color: var(--ink-3);
    color: var(--ink-2);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cfg__row.is-new {
      animation: cfg-flash 900ms var(--ease);
    }
  }
  @keyframes cfg-flash {
    from {
      background-color: var(--blue-wash);
    }
    to {
      background-color: transparent;
    }
  }

  .cfg__notes-wrap {
    margin-top: var(--s-3);
  }
  .cfg__notes-wrap[hidden] {
    display: none;
  }
  .cfg__notes-title {
    padding-bottom: var(--s-1);
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink);
  }
  .cfg__notes {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--paper);
  }
  .cfg__note {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: var(--s-1) var(--s-2);
    margin: 0;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .cfg__note-icon {
    padding-top: 2px;
    color: var(--blue);
    line-height: 0;
  }
  .cfg__note strong {
    font-weight: 600;
    color: var(--ink);
  }
  .cfg__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-2);
    margin-top: var(--s-3);
  }
  .cfg__disclaimer {
    margin-top: var(--s-2);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-3);
  }
  .cfg__static .cfg__disclaimer {
    margin-top: var(--s-2);
  }

  /* ---------- wersja zwarta (filary) i wąskie ekrany ---------- */
  .cfg--compact .cfg__ui {
    grid-template-columns: minmax(0, 1fr);
  }
  .cfg--compact .cfg__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .cfg--compact .cfg__sheet {
    border-left: 0;
  }
  .cfg--compact .cfg__q + .cfg__q {
    margin-top: 0;
  }
  .cfg--compact .cfg__q:first-child {
    grid-column: 1 / -1;
  }
  /* zwarta: w zestawieniu nazwa, status i link — uzasadnienia rozwija treść filaru poniżej */
  .cfg--compact .cfg__why-text {
    display: none;
  }
  .cfg--compact .cfg__row {
    padding-block: 12px;
  }
  .cfg--compact .cfg__formfoot {
    grid-column: 1 / -1;
    margin-top: 0;
  }
  /* szeroki ekran: pytania zostają w polu widzenia, gdy zestawienie jest dłuższe */
  @media (min-width: 1101px) {
    .cfg:not(.cfg--compact) .cfg__form {
      position: sticky;
      top: calc(var(--header-h) + var(--s-2));
      align-self: start;
    }
  }
  @media (max-width: 1100px) {
    .cfg__ui {
      grid-template-columns: minmax(0, 1fr);
    }
    .cfg__form {
      border-bottom: 1px solid var(--rule);
    }
    .cfg__sheet {
      border-left: 0;
    }
  }
  @media (max-width: 720px) {
    .cfg--compact .cfg__form {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .cfg__head,
    .cfg__static,
    .cfg__form,
    .cfg__sheet {
      padding-inline: var(--s-2);
    }
    .cfg__row {
      grid-template-columns: 1.75rem minmax(0, 1fr);
    }
    .cfg__icon {
      display: none;
    }
    .cfg__status {
      grid-column: 2;
      justify-self: start;
      margin-top: var(--s-1);
    }
    .cfg__actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
