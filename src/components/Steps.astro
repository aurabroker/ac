---
/**
 * Steps — etapy procesu jako schemat przepływu: symbol etapu w ramce, linia z grotem do następnego etapu,
 * tytuł, opis i to, co klient dostaje na końcu etapu. Desktop: kolumny; telefon: pion z linią po lewej.
 * W .md: lista numerowana (tytuł pogrubiony, opis, „Otrzymujesz: …”). Komórki: inline Markdown.
 *
 * MDX:
 * <Steps
 *   caption="Od pierwszej rozmowy do polisy"
 *   steps={[{ icon: "phone", title: "Rozmowa", text: "Pytamy o…", result: "listę informacji…" }]}
 * />
 */
import Icon from './Icon.astro';
import { inlineMd } from '../lib/inline-md.ts';
import { polishText } from '../lib/typography/polish.ts';

interface Step {
  icon?: string;
  title: string;
  text: string;
  result?: string;
}
interface Props {
  caption?: string;
  steps: Step[];
  /** Etykieta przed `result`. */
  resultLabel?: string;
}
const { caption, steps, resultLabel = 'Otrzymujesz:' } = Astro.props;
---

<div class="steps" role="group" aria-label={caption}>
  {caption && <p class="label steps__caption">{polishText(caption)}</p>}
  <ol class="steps__list">
    {
      steps.map((s, i) => (
        <li class="steps__item">
          <div class="steps__head" aria-hidden="true">
            <span class="steps__symbol">{s.icon && <Icon name={s.icon} size={26} />}</span>
            {i < steps.length - 1 && (
              <span class="steps__link">
                <span class="steps__line" />
                <Icon name="arrow-right" size={16} />
              </span>
            )}
          </div>
          <div class="steps__body">
            <p class="steps__num mono" aria-hidden="true">
              Etap {String(i + 1).padStart(2, '0')}
            </p>
            <p class="steps__title">
              <strong>{polishText(s.title)}</strong>
            </p>
            <p class="steps__text" set:html={inlineMd(s.text)} />
            {s.result && (
              <p class="steps__result">
                <span class="steps__result-label">{resultLabel}</span> <span set:html={inlineMd(s.result)} />
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .steps {
    margin-block: var(--s-4) var(--s-6);
  }
  .steps__caption {
    margin-bottom: var(--s-3);
  }
  .steps__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .steps__item {
    position: relative;
    margin: 0;
    padding: var(--s-3) var(--s-3) var(--s-3) 0;
  }
  .steps__item + .steps__item {
    padding-left: var(--s-3);
    border-left: 1px solid var(--rule);
  }
  .steps__head {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }
  .steps__symbol {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border: 1px solid var(--ink);
    color: var(--ink);
    background: var(--paper);
    transition:
      color 120ms var(--ease),
      border-color 120ms var(--ease),
      background-color 120ms var(--ease);
  }
  .steps__item:hover .steps__symbol {
    color: var(--blue);
    border-color: var(--blue);
    background: var(--blue-wash);
  }
  .steps__link {
    display: flex;
    flex: 1;
    align-items: center;
    min-width: 0;
    margin-right: calc(-1 * var(--s-3) - 1px);
    color: var(--ink-3);
  }
  .steps__line {
    flex: 1;
    border-top: 1px dashed var(--ink-4);
  }
  .steps__link :global(.icon) {
    margin-left: -3px;
    position: relative;
    z-index: 1;
    background: var(--paper);
  }
  .steps__num {
    margin-top: var(--s-2);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .steps__title {
    margin-top: 2px;
    font-size: 1.1875rem;
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
  }
  .steps__title strong {
    font-weight: 600;
  }
  .steps__text {
    margin-top: var(--s-1);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .steps__result {
    margin-top: var(--s-2);
    padding-top: var(--s-1);
    border-top: 1px dashed var(--rule);
    font-size: var(--fs-small);
    color: var(--ink);
  }
  .steps__result-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }
  /* telefon i tablet: pion — symbol po lewej, linia biegnie w dół do następnego etapu */
  @media (max-width: 900px) {
    .steps__list {
      grid-auto-flow: row;
      border-top: 0;
    }
    .steps__item,
    .steps__item + .steps__item {
      display: grid;
      grid-template-columns: 52px minmax(0, 1fr);
      column-gap: var(--s-2);
      padding: 0;
      border-left: 0;
    }
    .steps__head {
      flex-direction: column;
      align-self: stretch;
      gap: 0;
    }
    .steps__link {
      flex-direction: column;
      margin: 0;
      padding-block: 4px;
    }
    .steps__line {
      flex: 1;
      min-height: var(--s-2);
      border-top: 0;
      border-left: 1px dashed var(--ink-4);
    }
    .steps__link :global(.icon) {
      margin: -3px 0 0;
      transform: rotate(90deg);
    }
    .steps__body {
      padding-bottom: var(--s-4);
    }
    .steps__num {
      margin-top: 4px;
    }
  }
</style>
