---
/**
 * Spis treści z nagłówków H2 (opcjonalnie H3). Na ≥ 1280 px przyklejony w kolumnach 1–3.
 * headings: z `render(entry)` (Astro) — [{ depth, slug, text }].
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
  /** Dodatkowe pozycje (np. FAQ, Źródła) doklejane na końcu. */
  extra?: { slug: string; text: string }[];
  maxDepth?: 2 | 3;
  title?: string;
}
const { headings, extra = [], maxDepth = 2, title = 'Spis treści' } = Astro.props;
const items = [
  ...headings.filter((h) => h.depth >= 2 && h.depth <= maxDepth && h.slug !== 'w-skrocie'),
  ...extra.map((e) => ({ ...e, depth: 2 })),
];
---

{
  items.length > 1 && (
    <nav class="toc" aria-label={title} data-md-skip>
      <p class="label">{title}</p>
      <ol>
        {items.map((h) => (
          <li class:list={[`toc__d${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    font-size: var(--fs-small);
    line-height: 1.4;
  }
  .toc ol {
    list-style: none;
    margin: var(--s-1) 0 0;
    padding: 0;
    counter-reset: toc;
    border-left: 1px solid var(--rule);
  }
  .toc li {
    counter-increment: toc;
  }
  .toc a {
    display: block;
    padding: 6px 0 6px var(--s-2);
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: var(--ink-2);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--ink);
    border-left-color: var(--ink);
  }
  .toc__d3 a {
    padding-left: var(--s-4);
    font-size: 0.875rem;
  }
</style>
