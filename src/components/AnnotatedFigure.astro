---
/**
 * AnnotatedFigure — rysunek z numerem, podpisem i legendą odnośników (tekst w HTML).
 * SVG ma role="img" i aria-labelledby wskazujące legendę. W .md zostaje podpis i legenda.
 *
 * <AnnotatedFigure figure="FigPillarIT" />                       — podpis i legenda z FIGURE_META
 * <AnnotatedFigure figure="FigPillarIT" plotter />               — z jednorazowym rysowaniem (tylko hero)
 * <AnnotatedFigure code="F-12" caption="…" legend={['…']}>…<svg/>…</AnnotatedFigure>  — własny SVG w slocie
 *
 * Rysunek interaktywny (domyślnie w hero, gdy FIGURE_META ma `parts`): części rysunku (elementy SVG
 * z data-part="n") i balony są wskazywalne myszą, dotykiem i klawiaturą (przyciski nad balonami w kolejności
 * Tab, strzałki, Esc). Karta objaśnienia pod rysunkiem: tytuł, jedno zdanie, link; zanim coś wybierzesz —
 * lista części jako przyciski (w miejscu karty, bez skoku układu). Bez JS — legenda z linkami w tytułach pozycji. Skrypt: src/scripts/figure-parts.ts (tylko na stronach z takim rysunkiem).
 */
import Figure from './Figure.astro';
import Icon from './Icon.astro';
import PlotterHero from './PlotterHero.astro';
import FigurePartsScript from './FigurePartsScript.astro';
import { FIGURE_META, isFigureId } from './figures/index.ts';
import { polishText } from '../lib/typography/polish.ts';

interface Props {
  figure?: string;
  code?: string;
  caption?: string;
  legend?: string[];
  /** Jednorazowe rysowanie (PlotterHero) — tylko hero strony głównej i filarów. */
  plotter?: boolean;
  /** Wskazywalne części (wymaga `parts` w FIGURE_META). Domyślnie: tak w hero (plotter). */
  interactive?: boolean;
  /** Siatka kreślarska za rysunkiem. */
  grid?: boolean;
  /** Unikalny prefiks id (gdy kilka rysunków na stronie). */
  uid?: string;
}
const { figure, plotter = false, grid = true, uid } = Astro.props;
const meta = figure && isFigureId(figure) ? FIGURE_META[figure] : undefined;
const code = Astro.props.code ?? meta?.code ?? 'RYS.';
const caption = Astro.props.caption ?? meta?.caption ?? '';
const legend = Astro.props.legend ?? meta?.legend ?? [];
const base = (uid ?? code).toLowerCase().replace(/[^a-z0-9]+/g, '-');
const descId = `rys-${base}-opis`;
const parts = !Astro.props.legend && meta?.parts && meta.parts.length === legend.length ? meta.parts : undefined;
const interactive = !!parts && !!figure && (Astro.props.interactive ?? plotter);
const pad = (n: number) => String(n).padStart(2, '0');
/** Pozycja legendy „Tytuł — opis”: tytuł jako link do miejsca, które go rozwija (gdy są `parts`). */
const split = (item: string) => {
  const i = item.indexOf(' — ');
  return i > 0 ? [item.slice(0, i), item.slice(i)] : [item, ''];
};
---

<figure class:list={['afig', interactive && 'afig--interactive']} data-ifig={interactive ? '' : undefined}>
  {
    plotter ? (
      <PlotterHero grid={grid}>
        <div class="afig__drawing">
          {figure ? (
            <div class="ifig" data-ifig-stage>
              <Figure id={figure} labelledby={descId} />
            </div>
          ) : (
            <slot />
          )}
          {interactive && parts && (
            <div class="ifig__readout" data-ifig-readout data-md-skip hidden>
              <div class="ifig__idle is-shown" data-ifig-hint>
                <p class="ifig__hint">
                  <Icon name="magnifier" size={16} />
                  Wskaż część rysunku albo wybierz pozycję — pokażemy, co oznacza.
                </p>
                <ul class="ifig__chips" aria-label="Części rysunku">
                  {parts.map((pt, i) => (
                    <li>
                      <button type="button" class="ifig__chip" data-chip={i + 1}>
                        <span class="ifig__chip-num" aria-hidden="true">
                          {pad(i + 1)}
                        </span>
                        {polishText(pt.title)}
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
              {parts.map((pt, i) => (
                <div
                  class="ifig__card"
                  data-card={i + 1}
                  data-title={polishText(pt.title)}
                  role="group"
                  aria-labelledby={`${descId}-t${i + 1}`}
                  tabindex="-1"
                >
                  <span class="ifig__num">{pad(i + 1)}</span>
                  <div class="ifig__body">
                    <p class="ifig__title" id={`${descId}-t${i + 1}`}>
                      {polishText(pt.title)}
                    </p>
                    <p class="ifig__text" id={`${descId}-p${i + 1}`}>
                      {polishText(pt.text)}
                    </p>
                    <div class="ifig__foot">
                      <a class="ifig__link" href={pt.href}>
                        {polishText(pt.link)}
                        <Icon name="arrow-right" size={14} />
                      </a>
                      <button type="button" class="ifig__back" data-ifig-back>
                        Wszystkie części
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </PlotterHero>
    ) : (
      <div class:list={['afig__drawing', grid && 'drafting-grid']}>
        {figure ? <Figure id={figure} labelledby={descId} /> : <slot />}
      </div>
    )
  }
  <figcaption class="afig__caption" id={descId}>
    <span class="afig__code">{code}</span>
    <span class="afig__text">{polishText(caption)}</span>
    {
      legend.length > 0 && (
        <ol class="afig__legend">
          {legend.map((item, i) => {
            const pt = parts?.[i];
            if (!pt) return <li>{polishText(item)}</li>;
            const [head, rest] = split(item);
            return (
              <li data-part={i + 1}>
                <a href={pt.href}>{polishText(head)}</a>
                {polishText(rest)}
              </li>
            );
          })}
        </ol>
      )
    }
  </figcaption>
</figure>
{interactive && <FigurePartsScript />}

<style>
  .afig {
    margin: var(--s-6) 0;
  }
  .afig__drawing {
    border: 1px solid var(--rule);
    padding: clamp(8px, 2vw, 24px);
  }
  .afig__drawing :global(.fig-svg) {
    max-width: 880px;
    margin-inline: auto;
  }
  .afig__caption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-1) var(--s-2);
    margin-top: var(--s-2);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .afig__code {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--ink);
    padding-top: 2px;
  }
  .afig__legend {
    grid-column: 2;
    margin: 0;
    padding-left: 1.6em;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .afig__legend li::marker {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--ink);
  }
  .afig__legend a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }
  .afig__legend a:hover {
    color: var(--blue);
    text-decoration-color: var(--blue);
  }
  .afig__legend li {
    transition: color 120ms var(--ease);
  }
  .afig__legend li.is-on,
  .afig__legend li.is-on::marker,
  .afig__legend li.is-on a {
    color: var(--blue);
  }
</style>
