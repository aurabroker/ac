---
/**
 * Tabliczka rysunkowa arkusza: nr arkusza, rewizja, data, „Autor” (tylko w zwartej tabliczce pod H1
 * i tylko na arkuszach eksperckich — autor pojawia się na stronie raz), „Pobierz .md”.
 * variant="compact" — pod H1 (na mobile jedna linia); variant="full" — na końcu strony (bez autora).
 * Metadane są we frontmatterze bliźniaka .md, więc tabliczka ma data-md-skip.
 */
import Icon from './Icon.astro';
import { fmtDate, isoDate } from '../lib/format.ts';
import { SITE } from '../lib/site.ts';

interface Props {
  sheet: string;
  revision: string;
  updated: Date;
  published?: Date;
  /** Tylko variant="compact". Brak = strona firmowa/prawna (bez pola „Autor”). */
  author?: string;
  /** Strona autora (link w polu „Autor”). */
  authorHref?: string;
  mdPath?: string | null;
  title?: string;
  variant?: 'compact' | 'full';
  draft?: boolean;
}
const { sheet, revision, updated, published, author, authorHref, mdPath, title, variant = 'compact', draft } =
  Astro.props;
const showAuthor = variant === 'compact' && !!author;
---

<div class:list={['title-block', `title-block--${variant}`]} data-md-skip role="group" aria-label="Tabliczka arkusza">
  <dl class="title-block__grid">
    {
      variant === 'full' && title && (
        <div class="tbc tbc--title">
          <dt>Tytuł</dt>
          <dd>{title}</dd>
        </div>
      )
    }
    <div class="tbc tbc--sheet">
      <dt>Arkusz</dt>
      <dd>{sheet}{draft && <span class="title-block__draft"> · SZKIC</span>}</dd>
    </div>
    <div class="tbc tbc--rev">
      <dt>Rew.</dt>
      <dd><span aria-hidden="true">△ </span>{revision}</dd>
    </div>
    {
      variant === 'full' && published && (
        <div class="tbc">
          <dt>Opublikowano</dt>
          <dd>
            <time datetime={isoDate(published)}>{fmtDate(published)}</time>
          </dd>
        </div>
      )
    }
    <div class="tbc">
      <dt>{variant === 'full' ? 'Zaktualizowano' : 'Data'}</dt>
      <dd><time datetime={isoDate(updated)}>{fmtDate(updated)}</time></dd>
    </div>
    {
      showAuthor && (
        <div class="tbc tbc--person tbc--author">
          <dt>Autor</dt>
          <dd>{authorHref ? <a href={authorHref}>{author}</a> : author}</dd>
        </div>
      )
    }
    {
      variant === 'full' && (
        <div class="tbc tbc--wide">
          <dt>Wydawca</dt>
          <dd>{SITE.legalName} · KNF {SITE.knfPermit}</dd>
        </div>
      )
    }
    {
      mdPath && (
        <div class="tbc tbc--md">
          <dt>Format</dt>
          <dd>
            <a class="title-block__md" href={mdPath} type="text/markdown"><Icon name="document-md" size={16} />Pobierz .md</a>
          </dd>
        </div>
      )
    }
  </dl>
</div>

<style>
  .title-block {
    margin-block: var(--s-4);
  }
  .title-block__grid {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }
  .tbc {
    flex: 1 1 auto;
    min-width: 0;
    padding: 6px 14px 7px 10px;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .tbc--sheet {
    flex-grow: 0;
  }
  .tbc--title,
  .tbc--wide {
    flex-basis: 100%;
  }
  .tbc--title dd {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: var(--tracking-tight);
  }
  .title-block dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
    line-height: 1.3;
  }
  .title-block dd {
    margin: 1px 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--ink);
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .title-block__md {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .title-block__draft {
    color: var(--signal);
  }
  .title-block--full {
    max-width: var(--end-measure, 100%);
    margin-top: var(--s-12);
  }
  @media (max-width: 720px) {
    /* mobile: zwarta linia — arkusz · data · autor · .md; zawija się zamiast przewijać */
    .title-block--compact .title-block__grid {
      flex-wrap: wrap;
      border: 0;
      border-block: 1px solid var(--ink);
      gap: 0;
    }
    .title-block--compact .tbc {
      flex: none;
      border: 0;
      border-right: 1px solid var(--rule);
      padding: 6px 10px;
    }
    .title-block--compact .tbc:first-child {
      padding-left: 0;
    }
    .title-block--compact .tbc--rev {
      display: none;
    }
    .title-block--compact .tbc:last-child {
      border-right: 0;
    }
    /* „Pobierz .md” zawsze w osobnym wierszu, wyrównane do lewej krawędzi tabliczki */
    .title-block--compact .tbc--md {
      flex-basis: 100%;
      padding-left: 0;
      border-top: 1px dashed var(--rule);
    }
    .title-block--compact .tbc--md dt {
      display: none;
    }
  }
</style>
