---
/** Rejestr zmian (△). Bez wpisów: jedna pozycja „Pierwsze wydanie” z datą publikacji. */
import { fmtDate, isoDate } from '../lib/format.ts';
import { polishText } from '../lib/typography/polish.ts';

interface Props {
  items: { rev: string; date: Date; note: string }[];
  published: Date;
  revision: string;
}
const { items, published, revision } = Astro.props;
const rows = items.length ? items : [{ rev: revision, date: published, note: 'Pierwsze wydanie.' }];
---

<section class="revlog" aria-labelledby="rejestr-zmian">
  <h2 id="rejestr-zmian">Rejestr zmian</h2>
  <div class="table-wrap" role="region" tabindex="0" aria-label="Rejestr zmian">
    <table>
      <caption class="visually-hidden">Rejestr zmian arkusza</caption>
      <thead>
        <tr><th scope="col">Rew.</th><th scope="col">Data</th><th scope="col">Zmiana</th></tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td class="mono">
                <span aria-hidden="true">△ </span>
                {r.rev}
              </td>
              <td class="mono">
                <time datetime={isoDate(r.date)}>{fmtDate(r.date)}</time>
              </td>
              <td>{polishText(r.note)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .revlog {
    max-width: var(--end-measure, 100%);
    margin-top: var(--s-10);
  }
  .revlog h2 {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
  }
  .revlog .table-wrap {
    margin-top: var(--s-1);
  }
  .revlog td {
    font-size: var(--fs-small);
    padding-block: var(--s-1);
  }
  .revlog td.mono {
    white-space: nowrap;
  }
</style>
