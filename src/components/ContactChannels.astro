---
/**
 * Kontakt: telefon albo formularz (decyzja właściciela 4.11.2026 — bez adresu e-mail, mailto i kopiowania).
 * Formularz → POST /api/kontakt; temat wiadomości zawiera tytuł strony. Lista „Co przygotować” opcjonalnie.
 * W bliźniaku .md zostają: nagłówek, lead, telefon, link do formularza i lista (sam formularz ma data-md-skip).
 */
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';
import { SITE } from '../lib/site.ts';
import { polishText } from '../lib/typography/polish.ts';

interface Props {
  heading?: string;
  lead?: string;
  /** Pokaż listę „Co przygotować”. */
  checklist?: boolean;
  id?: string;
  /** Tytuł podstrony do tematu wiadomości z formularza. */
  pageTitle?: string;
}
const {
  heading = 'Zleć analizę ryzyka',
  lead = 'Zadzwoń albo wyślij wiadomość przez formularz. Analiza i porównanie ofert nie zobowiązują do zakupu polisy.',
  checklist = true,
  id = 'kontakt',
  pageTitle = 'Kontakt',
} = Astro.props;
---

<section class="contact" aria-labelledby={id} data-contact>
  <h2 id={id}>{polishText(heading)}</h2>
  <p class="contact__lead">{polishText(lead)}</p>

  <div class="contact__channels">
    <div class="contact__channel">
      <span class="contact__symbol" aria-hidden="true"><Icon name="phone" size={22} /></span>
      <div>
        <p class="label">Telefon</p>
        <a class="contact__value" href={`tel:${SITE.phoneE164}`}>{SITE.phone}</a>
        <p class="contact__hint">{SITE.phoneHours}</p>
      </div>
    </div>
    <div class="contact__channel">
      <span class="contact__symbol" aria-hidden="true"><Icon name="form" size={22} /></span>
      <div>
        <p class="label">Formularz</p>
        <a class="contact__value contact__value--text" href="#formularz">Wyślij wiadomość</a>
      </div>
    </div>
  </div>

  <ContactForm pageTitle={pageTitle} />

  <p class="contact__privacy" data-md-skip>
    Administratorem danych z korespondencji jest {SITE.legalName} —{' '}
    <a href="/polityka-prywatnosci/">polityka prywatności</a>.
  </p>

  {
    checklist && (
      <div class="contact__prep">
        <p class="label">Co przygotować</p>
        <ul>
          <li>krótki opis działalności i głównych usług lub produktów,</li>
          <li>przychód (rząd wielkości) i strukturę klientów, w tym zagranicznych,</li>
          <li>obecną polisę lub ofertę (jeśli jest) i termin odnowienia,</li>
          <li>zapisy umów, które wymagają ubezpieczenia (limit, zakres, certyfikat).</li>
        </ul>
      </div>
    )
  }
</section>

<style>
  .contact {
    max-width: var(--end-measure, 100%);
    margin-top: var(--s-10);
    padding: var(--s-4);
    border: 1px solid var(--ink);
  }
  .contact__lead {
    margin-top: var(--s-1);
    color: var(--ink-2);
    max-width: 60ch;
  }
  .contact__channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
    margin-top: var(--s-3);
    padding-top: var(--s-2);
    border-top: 1px solid var(--rule);
  }
  .contact__channel {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
    min-width: 0;
  }
  .contact__channel > div {
    min-width: 0;
  }
  .contact__symbol {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    color: var(--ink-2);
  }
  .contact__channel:hover .contact__symbol {
    color: var(--blue);
    border-color: var(--blue);
  }
  .contact__value {
    display: inline-block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact__value:hover {
    text-decoration: underline;
  }
  .contact__value--text {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--blue);
  }
  .contact__hint {
    margin: 2px 0 0;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .contact__privacy {
    margin-top: var(--s-2);
    margin-bottom: 0;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .contact__prep {
    margin-top: var(--s-3);
  }
  .contact__prep ul {
    margin: var(--s-1) 0 0;
    padding-left: 1.2em;
    color: var(--ink-2);
    font-size: var(--fs-small);
  }
  @media (max-width: 640px) {
    .contact {
      padding: var(--s-3) var(--s-2);
    }
    .contact__channels {
      grid-template-columns: 1fr;
    }
  }
</style>
