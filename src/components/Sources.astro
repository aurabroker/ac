---
/**
 * Numerowane źródła z datą dostępu (T1–T3) + jedna dyskretna linia noty (`note`, etykieta `noteLabel`).
 * Bez źródeł, a z notą — sama linia noty (bez nagłówka).
 */
import Icon from './Icon.astro';
import { fmtDate, isoDate } from '../lib/format.ts';
import { polishText } from '../lib/typography/polish.ts';

interface Source {
  title: string;
  url: string;
  publisher?: string;
  accessed: Date;
  tier?: 'T1' | 'T2' | 'T3';
}
interface Props {
  items: Source[];
  heading?: string;
  /** Nota (treść po etykiecie; src/lib/compliance.ts → creationNote / editorialNote). */
  note?: string;
  /** Etykieta noty: „Jak powstał ten tekst” (artykuły) albo „Opracowanie” (rozwiązania). */
  noteLabel?: string;
}
const { items, heading = 'Źródła', note, noteLabel = 'Jak powstał ten tekst' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="sources" aria-labelledby="zrodla">
      <h2 id="zrodla"><Icon name="document" size={16} />{heading}</h2>
      <ol>
        {items.map((s) => (
          <li>
            {/* bez łamania linii wewnątrz elementów — inaczej w HTML i .md pojawiają się zbędne spacje */}
            <a href={s.url} rel="noopener">{s.title}</a>{s.publisher && <span>, {s.publisher}</span>}{' '}
            <span class="sources__meta">(dostęp: <time datetime={isoDate(s.accessed)}>{fmtDate(s.accessed)}</time>{s.tier && <span>, {s.tier}</span>})</span>
          </li>
        ))}
      </ol>
      {note && <p class="sources__how"><Icon name="info" size={16} /><span><strong>{noteLabel}:</strong> {polishText(note)}</span></p>}
    </section>
  )
}
{items.length === 0 && note && <p class="sources__how sources__how--solo"><Icon name="info" size={16} /><span><strong>{noteLabel}:</strong> {polishText(note)}</span></p>}

<style>
  /* źródła: drobny druk pod treścią — nagłówek jak etykieta arkusza, lista 13 px */
  .sources {
    max-width: var(--end-measure, 100%);
    margin-top: var(--s-10);
    font-size: var(--fs-mono);
    line-height: 1.55;
  }
  .sources h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .sources h2 :global(.icon) {
    color: var(--ink-3);
  }
  .sources ol {
    margin: var(--s-2) 0 0;
    padding-left: 1.8em;
  }
  .sources li + li {
    margin-top: 6px;
  }
  .sources li::marker {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--ink-3);
  }
  .sources a {
    overflow-wrap: anywhere;
  }
  .sources__meta {
    color: var(--ink-3);
  }
  .sources__how {
    display: flex;
    gap: var(--s-1);
    align-items: flex-start;
    margin-top: var(--s-3);
    padding-top: var(--s-2);
    border-top: 1px dashed var(--rule);
    font-size: var(--fs-label);
    line-height: 1.55;
    color: var(--ink-3);
  }
  .sources__how :global(.icon) {
    margin-top: 2px;
  }
  .sources__how strong {
    font-weight: 600;
    color: var(--ink-2);
  }
  .sources__how--solo {
    margin-top: var(--s-8);
  }
</style>
