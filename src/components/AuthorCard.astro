---
/**
 * Autor + dane spółki z KNF + nota „Jak powstał ten tekst”.
 * Dopóki imię właściciela to „TODO…”, pokazuje „Zespół Aura Consulting” (bez linku do osoby).
 */
import { SITE } from '../lib/site.ts';
import { displayName, isKnownPerson, personPath, type Person } from '../lib/people.ts';
import { NOTE_AI_ASSISTANCE, NOTE_EDITORIAL } from '../lib/compliance.ts';
import { polishText } from '../lib/typography/polish.ts';

interface Props {
  person: Person;
  aiAssistance?: boolean;
  heading?: string;
}
const { person, aiAssistance = true, heading = 'Autor' } = Astro.props;
const name = displayName(person);
const known = isKnownPerson(person);
---

<section class="author" aria-labelledby="autor">
  <h2 id="autor" class="author__heading">{heading}</h2>
  <div class="author__grid">
    <div>
      <p class="label">Autor</p>
      <p class="author__name">
        {known ? <a href={personPath(person)}>{name}</a> : name}
      </p>
      <p class="author__role">{known ? person.role : `${SITE.legalName} — broker ubezpieczeniowy`}</p>
    </div>
    <div class="author__company">
      <p class="label">Spółka</p>
      <p>
        {SITE.legalName} · zezwolenie KNF nr {SITE.knfPermit} · rejestr brokerów {SITE.brokerRegister} · KRS {SITE.krs}
      </p>
    </div>
  </div>
  <p class="author__note"><strong>Jak powstał ten tekst.</strong> {polishText(aiAssistance ? NOTE_AI_ASSISTANCE : NOTE_EDITORIAL)}</p>
</section>

<style>
  .author {
    max-width: var(--end-measure, 100%);
    margin-top: var(--s-10);
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
  }
  .author__heading {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .author__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .author__name {
    font-weight: 600;
    font-size: 1.125rem;
    margin-top: 4px;
  }
  .author__role,
  .author__company p:last-child {
    font-size: var(--fs-small);
    color: var(--ink-2);
    margin-top: 4px;
  }
  .author__note {
    margin-top: var(--s-3);
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .author__note strong {
    color: var(--ink-2);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .author__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
