---
/**
 * Karta arkusza w indeksach (katalog, rejestr wiedzy, „Arkusze szczegółowe”, „Powiązane”).
 * Cała karta jest linkiem przez tytuł (jeden <a>), numer arkusza w Plex Mono.
 * Symbol w ramce: ikona strony wg adresu (src/lib/icons.ts → iconForPath); `icon="…"` zmienia, `icon={false}` wyłącza.
 * Miniatura u góry: rysunek izometryczny strony docelowej (/fig/<ścieżka>.svg, src/lib/iso) jako <img> — lekki DOM
 * przy wielu kartach; tylko dla stron z tego buildu; `thumb={false}` wyłącza. W .md pomijana.
 */
import Icon from './Icon.astro';
import { iconForPath } from '../lib/icons.ts';
import { polishText } from '../lib/typography/polish.ts';
import { fmtDate, isoDate } from '../lib/format.ts';
import { existingPaths } from '../lib/routes.ts';
import { figPathFor } from '../lib/iso/spec.ts';

interface Props {
  href: string;
  title: string;
  sheet?: string;
  summary?: string;
  meta?: string;
  /** Poziom nagłówka tytułu. */
  level?: 2 | 3 | 4;
  draft?: boolean;
  /** Data publikacji z harmonogramu, gdy jeszcze nie nadeszła (tylko podgląd): „Zaplanowano: dd.mm.rrrr”. */
  scheduled?: Date;
  icon?: string | false;
  /** Miniatura strony docelowej (domyślnie tak). */
  thumb?: boolean;
}
const { href, title, sheet, summary, meta, level = 3, draft, scheduled } = Astro.props;
const H = `h${level}` as 'h2' | 'h3' | 'h4';
const icon = Astro.props.icon === false ? undefined : (Astro.props.icon ?? iconForPath(href));
const target = href.split('#')[0];
const fig = Astro.props.thumb !== false && (await existingPaths()).has(target) ? figPathFor(target) : undefined;
---

<article class:list={['sheet-card', fig && 'sheet-card--fig']}>
  {
    fig && (
      <div class="sheet-card__fig" aria-hidden="true" data-md-skip>
        <img src={fig} width="360" height="190" loading="lazy" decoding="async" alt="" />
      </div>
    )
  }
  {
    (icon || sheet) && (
      <div class="sheet-card__head">
        {icon && (
          <span class="sheet-card__symbol" aria-hidden="true">
            <Icon name={icon} size={24} />
          </span>
        )}
        {sheet && <p class="sheet-card__sheet mono">{sheet}{draft && ' · SZKIC'}</p>}
      </div>
    )
  }
  {
    scheduled && (
      <p class="sheet-card__plan mono">
        Zaplanowano: <time datetime={isoDate(scheduled)}>{fmtDate(scheduled)}</time>
      </p>
    )
  }
  <H class="sheet-card__title"><a href={href}>{polishText(title)}</a></H>
  {summary && <p class="sheet-card__summary">{polishText(summary)}</p>}
  <div class="sheet-card__foot">
    {meta && <p class="sheet-card__meta mono">{meta}</p>}
    <span class="sheet-card__go" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
  </div>
</article>

<style>
  .sheet-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-3);
    border: 1px solid var(--rule);
    background: var(--paper);
    transition: border-color 120ms var(--ease);
    height: 100%;
  }
  .sheet-card:hover,
  .sheet-card:focus-within {
    border-color: var(--ink);
  }
  /* linia wymiarowa u dołu karty (|—|), kreślona od lewej po najechaniu lub fokusie */
  .sheet-card::before {
    content: '';
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    bottom: 9px;
    height: 7px;
    border-inline: 1px solid var(--blue);
    background: linear-gradient(var(--blue), var(--blue)) 0 3px / 100% 1px no-repeat;
    clip-path: inset(0 100% 0 0);
    pointer-events: none;
  }
  .sheet-card:hover::before,
  .sheet-card:focus-within::before {
    clip-path: inset(0 0 0 0);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sheet-card::before {
      transition: clip-path 320ms var(--ease);
    }
  }
  /* miniatura na całą szerokość karty, oddzielona linią */
  .sheet-card__fig {
    margin: calc(-1 * var(--s-3)) calc(-1 * var(--s-3)) var(--s-1);
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
    transition: border-color 120ms var(--ease);
  }
  .sheet-card__fig img {
    display: block;
    width: 100%;
    /* miniatura 360×190 najwyżej ~1,3×: w szerokiej karcie (jedna kolumna, tablet) wyśrodkowana, bez nadmuchanych podpisów */
    max-width: 460px;
    margin-inline: auto;
    height: auto;
  }
  .sheet-card:hover .sheet-card__fig,
  .sheet-card:focus-within .sheet-card__fig {
    border-color: var(--ink);
  }
  .sheet-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    margin-bottom: var(--s-1);
  }
  .sheet-card__symbol {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    color: var(--ink-2);
    background: var(--paper);
    transition:
      color 120ms var(--ease),
      border-color 120ms var(--ease);
  }
  .sheet-card:hover .sheet-card__symbol,
  .sheet-card:focus-within .sheet-card__symbol {
    color: var(--blue);
    border-color: var(--blue);
  }
  .sheet-card__sheet {
    color: var(--ink-3);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
  }
  .sheet-card__plan {
    margin: 0;
    color: var(--blue);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
  }
  .sheet-card__title {
    /* scoped (.sheet-card__title[data-astro-cid]) wygrywa z `.prose h3 { margin-top }` */
    margin: 0;
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .sheet-card__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .sheet-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .sheet-card__title a:hover {
    text-decoration: underline;
  }
  .sheet-card__summary {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .sheet-card__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-2);
    margin-top: auto;
    padding-top: var(--s-1);
  }
  .sheet-card__meta {
    color: var(--ink-3);
  }
  .sheet-card__go {
    margin-left: auto;
    color: var(--ink-3);
    line-height: 0;
    transition: color 120ms var(--ease);
  }
  .sheet-card:hover .sheet-card__go,
  .sheet-card:focus-within .sheet-card__go {
    color: var(--blue);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sheet-card__go {
      transition:
        color 120ms var(--ease),
        transform 160ms var(--ease);
    }
    .sheet-card:hover .sheet-card__go,
    .sheet-card:focus-within .sheet-card__go {
      transform: translateX(4px);
    }
  }
</style>
