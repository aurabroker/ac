---
/**
 * Stopka arkusza: rejestr zmian i pełna tabliczka rysunkowa (arkusz, rewizja, daty, wydawca, .md).
 * Autor jest pokazany raz — w zwartej tabliczce pod H1; nota „Jak powstał ten tekst” stoi przy źródłach.
 */
import RevisionLog from './RevisionLog.astro';
import TitleBlock from './TitleBlock.astro';
import type { PageContext } from '../lib/page.ts';

interface Props {
  ctx: PageContext;
  revisions?: boolean;
}
const { ctx, revisions = true } = Astro.props;
const d = ctx.route.entry.data;
---

{revisions && <RevisionLog items={d.changelog} published={d.published} revision={d.revision} />}
<TitleBlock
  variant="full"
  title={ctx.title}
  sheet={d.sheet}
  revision={d.revision}
  updated={d.updated}
  published={d.published}
  mdPath={ctx.mdPath}
  draft={ctx.draft}
/>
