---
/**
 * Stopka arkusza: pełna tabliczka rysunkowa (arkusz, rewizja, daty, wydawca, .md).
 * Rejestr zmian (`changelog`) nie jest pokazywany czytelnikom — zostaje w danych treści i w historii git.
 * Autor (tylko artykuły i regulacje) jest pokazany raz — w zwartej tabliczce pod H1.
 */
import TitleBlock from './TitleBlock.astro';
import type { PageContext } from '../lib/page.ts';

interface Props {
  ctx: PageContext;
}
const { ctx } = Astro.props;
const d = ctx.route.entry.data;
---

<TitleBlock
  variant="full"
  title={ctx.title}
  sheet={d.sheet}
  revision={d.revision}
  updated={d.updated}
  published={d.published}
  mdPath={ctx.mdPath}
  draft={ctx.draft}
  scheduled={ctx.scheduled}
/>
